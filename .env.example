# Shared
APP_ENV=local
APP_NAME=OpenChimney
APP_VERSION=0.1.0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DATABASE_URL=sqlite:///./data/app.db
ARTIFACT_STORAGE_DIR=./data/artifacts
SECRET_KEY=change-me-in-production
RUNNER_API_KEY=dev-runner-key
CORS_ORIGINS=http://localhost:5173
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin1234
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=superadmin1234

# Web
VITE_API_BASE_URL=http://localhost:8000
WEB_PORT=80

# Runner
RUNNER_NAME=local-runner
RUNNER_API_BASE_URL=http://localhost:8000
RUNNER_POLL_INTERVAL_SECONDS=5
RUNNER_EMPTY_POLL_INTERVAL_SECONDS=5
RUNNER_JOB_HEARTBEAT_SECONDS=10
RUNNER_MAX_CONCURRENCY=1
RUNNER_CAPABILITIES=ai.chat
RUNNER_LOG_LEVEL=INFO

# External LLM provider secrets for real runner providers.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Optional Docker runtime limits.
API_MEM_LIMIT=768m
RUNNER_MEM_LIMIT=768m
WEB_MEM_LIMIT=128m
