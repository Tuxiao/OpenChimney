# Copy this file to .env before Docker deployment.

# Compose
APP_ENV=production
APP_VERSION=latest
WEB_PORT=80

# API
API_WORKERS=1
DATABASE_URL=sqlite:////data/app.db
ARTIFACT_STORAGE_DIR=/data/artifacts
SECRET_KEY=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=2592000
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-super-admin-password
# Same-origin Docker deployment can keep this as "*".
# For split domains, set for example: https://app.example.com
CORS_ORIGINS=*

# Runner auth shared by API and runner.
RUNNER_API_KEY=replace-with-a-long-random-runner-key

# Web
# Empty means browser calls the same origin through Nginx /api reverse proxy.
# Set to https://api.example.com only when API is deployed on another origin,
# then rebuild the web image.
VITE_API_BASE_URL=

# Runner
RUNNER_NAME=runner-01
RUNNER_AGENT_RUNTIME=hermes
RUNNER_POLL_INTERVAL_SECONDS=2
RUNNER_EMPTY_POLL_INTERVAL_SECONDS=5
RUNNER_JOB_HEARTBEAT_SECONDS=10
RUNNER_MAX_CONCURRENCY=1
RUNNER_CAPABILITIES=ai.agent.v1,ai.chat
RUNNER_LOG_LEVEL=INFO

# Hermes Agent runtime. Hermes is pinned in apps/runner/pyproject.toml.
# The admin console stores the active Hermes runtime settings in SQLite.
# These env values are startup fallbacks before the runner reads that API config.
HERMES_MODEL=anthropic/claude-sonnet-4.6
HERMES_PROVIDER=
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_HOME=/runner/.hermes
HERMES_WORKSPACE_ROOT=/runner/workspaces
HERMES_MAX_ITERATIONS=20
HERMES_DEFAULT_TOOLSETS=safe
HERMES_ALLOWED_TOOLSETS=safe,web,search,vision,image_gen,mcp-sqlite-service
HERMES_MEMORY_MODE=tenant
HERMES_TIMEOUT_SECONDS=300

# Provider secrets used by Hermes Agent.
# Keep these in .env only; do not commit real values.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 4GB VPS-friendly default memory caps.
API_MEM_LIMIT=768m
RUNNER_MEM_LIMIT=1536m
WEB_MEM_LIMIT=128m
